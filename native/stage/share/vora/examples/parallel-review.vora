workflow ParallelReview(input):
    agent writer = "Write a concise draft for the task."
    agent factual = "Identify unsupported factual claims in the draft."
    agent style = "Suggest concrete clarity improvements to the draft."
    agent editor = "Use both reviews to improve the draft. Return final text."
    draft = writer("Task: {input}")
    fact_review = factual("Task: {input}\nDraft: {draft}")
    style_review = style("Draft: {draft}")
    final = editor("Draft: {draft}\nFacts: {fact_review}\nStyle: {style_review}")
    return final
